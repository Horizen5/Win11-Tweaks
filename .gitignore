# ============================================================
#  Win11-Tweaks  .gitignore
#  以下目录/文件不上传（含本机机器名、用户名与个人目录路径）
# ============================================================

# ---- 构建中间产物、测试归档、排错脚本 ----
# 这些文件由本工具导出，形式上就带 machine / user / 壁纸绝对路径
win11tweaks/build/

# ---- 工作区记忆（个人偏好、硬件与网络基线）----
.workbuddy/

# ---- 第三方原始素材（非本项目产出，版权不属于本仓库）----
src_win11/

# ---- 编译中间产物兜底 ----
*.obj
*.pdb
*.ilk
*.exp
*.res
*.exe
!win11tweaks/dist/Win11Tweaks.exe

# ---- 运行时生成的还原点 ----
win11tweaks/dist/backups/*
!win11tweaks/dist/backups/.gitkeep
